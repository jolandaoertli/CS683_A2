#include "cache.h"

#define maxRRPV 3
uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t  l2_is_instr[L2C_SET][L2C_WAY];
uint8_t  l2_age_toggle[L2C_SET];
#ifndef IRRIP_INSTR_INSERT
#define IRRIP_INSTR_INSERT 0 //RRPV for a instruction line
#endif
#ifndef IRRIP_DATA_INSERT
#define IRRIP_DATA_INSERT 3 //RRPV for a data line
#endif
//promotion
#ifndef IRRIP_INSTR_HIT
#define IRRIP_INSTR_HIT 0
#endif
#ifndef IRRIP_DATA_HIT
#define IRRIP_DATA_HIT 2
#endif
#ifndef IRRIP_WB_HIT_PROMOTE
#define IRRIP_WB_HIT_PROMOTE 0
#endif
#ifndef IRRIP_INSTR_AGE_PERIOD
#define IRRIP_INSTR_AGE_PERIOD 2
#endif
#ifndef IRRIP_PROTECT_ITLB_WALK
#define IRRIP_PROTECT_ITLB_WALK 0
#endif
static inline bool is_code(uint32_t type, uint8_t instruction)
{
    if(!instruction) return false;
    if(type == LOAD || type == PREFETCH){
        return true;
    }
    return IRRIP_PROTECT_ITLB_WALK && (type == LOAD_TRANSLATION || type == PREFETCH_TRANSLATION);
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize SRRIP state for L2C" << endl;

    for (int i=0; i<L2C_SET; i++) {
        l2_age_toggle[i] = 0;
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            l2_is_instr[i][j] = 0;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    //find invalid
    for(int i = 0; i < L2C_WAY; i++){
        if(!current_set[i].valid){
            return i;
        }
    }
    // look for the maxRRPV line
    while (1)
    {
        //prefer data over instruction eviction
        for(int i=0; i<L2C_WAY; i++){
            if(l2_rrpv[set][i] == maxRRPV && !l2_is_instr[set][i]){
                return i;
            }
        }
        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        //instruction lines age every age period
        l2_age_toggle[set] = (l2_age_toggle[set] + 1) % IRRIP_INSTR_AGE_PERIOD;
        bool age_instr = (l2_age_toggle[set] == 0);
        for(int i=0; i<L2C_WAY; i++){
            if(!l2_is_instr[set][i] || l2_age_toggle[set]){
                l2_rrpv[set][i]++;
            }
        }
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    bool code = is_code(type, isInstruction);
    l2_is_instr[set][way] = code ? 1 : 0;
    if(hit) {
        if(type == WRITEBACK && !IRRIP_WB_HIT_PROMOTE){
            return;
        }
        if(l2_is_instr[set][way]){
            l2_rrpv[set][way] = IRRIP_INSTR_HIT;
        }else{
            l2_rrpv[set][way] = IRRIP_DATA_HIT;
        }
    } else {
        l2_rrpv[set][way] = code ? IRRIP_INSTR_INSERT : IRRIP_DATA_INSERT;
    }
}

