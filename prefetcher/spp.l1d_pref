
// L1D Stride Pattern Prefetcher
// each load IP records its recent line, stride, confidence, and signature

#include "cache.h"

// load instruction entries in the IP table.
#define IPT_SIZE       64
// low 16 IP bits are stored
#define IPT_TAG_BITS   16
// low address bits retained for calculating a small stride
#define LINE_BITS      16
// strides > 63 lines are treated on next page
#define MAX_STRIDE     63
// max value of the uniform-stride confidence counter
#define CONF_MAX       3
// uniform prediction counter threshold
#define UNIFORM_THRESH 3

//signature is history of recently observed strides
#define SIG_BITS       10
// 3 bits are shifted in for every new stride
#define SIG_SHIFT      3
// 10bit signature gives 1024 possible SPT indexes
#define SIG_SIZE       (1u << SIG_BITS)
// max confidence for an SPT prediction
#define SPT_CONF_MAX   3
// spt prediction thres
#define SPT_THRESH     1

// enteries direct-mapped prefetch filter
#define FILTER_SIZE    64
// stored tag bits in filter entry
#define FILTER_TAG_BITS 12

// recalculate accuracy after this many successfully issued prefetches.
#define EPOCH_SIZE     256
// min degree
#define MIN_DEGREE     1
// max degree
#define MAX_DEGREE     4
// initial degree
#define INITIAL_DEGREE 2
// accuracy thresholds used by the adaptive degree controller
#define ACC_HIGH 75
#define ACC_MID  50
#define ACC_LOW  20

namespace spp {

// data for each load ip
struct IPEntry {
    bool valid;       // 1, when row is occupied
    bool has_sig;      // 1 after at least one stride was added to sig
    uint16_t tag;        // Low IPT_TAG_BITS bits of the ip
    uint16_t last_line;  // Low LINE_BITS bits of the last cache-line
    uint16_t sig;      // stride history used to index the spt
    int8_t last_stride;  // last stide observed
    uint8_t conf;        // Confidence for uniform
    uint8_t lru;       // 0 is most recently used, IPT_SIZE-1 is oldest.
};

// entry of spt
struct SPTEntry {
    int8_t stride;       // next stride for this signature.
    uint8_t conf;      // confidence
};

// One recently issued prefetch remembered by the usefulness checker.
struct FilterEntry {
    bool valid;          // 1 when row contains a prefetch.
    bool used;           // 1 after a demand access used the prefetch
    uint16_t tag;      // identifies the line stored in this filter row
    uint8_t epoch;       // epoch in which the prefetch was issued
};

// tables usedby the prefetcher
IPEntry ipt[IPT_SIZE];
SPTEntry spt[SIG_SIZE];
FilterEntry filter[FILTER_SIZE];

// per epoch counters and the current prefetch aggressiveness.
uint32_t epoch_issued, epoch_useful, degree;
// epoch id
uint8_t epoch_id;
// lifetime statistics
uint64_t total_issued, total_useful;

// extract the tag used to find IP entry
inline uint16_t ip_tag(uint64_t ip) { return ip & ((1u << IPT_TAG_BITS) - 1); }
// low address bits needed for local stride calculation
inline uint16_t line_low(uint64_t line) { return line & ((1u << LINE_BITS) - 1); }
// cache line into page number
inline uint64_t page(uint64_t line) { return line >> (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE); }
// select the direct-mapped filter row using the low line-address bits
inline uint32_t filter_index(uint64_t line) { return line & (FILTER_SIZE - 1); }
// line address bits above the filter index as the filter tag
inline uint16_t filter_tag(uint64_t line)
{
    return (line >> 6) & ((1u << FILTER_TAG_BITS) - 1);
}

// add new stride to the signature
// shift old to left by 3,xor in the new 7bit stride,use only 10 bits
inline uint16_t next_sig(uint16_t sig, int8_t stride)
{
    return ((sig << SIG_SHIFT) ^ (stride & 0x7f)) & (SIG_SIZE - 1);
}

//search table for ip entry
inline int find_ip(uint16_t tag)
{
    for (uint32_t i = 0; i < IPT_SIZE; ++i)
        if (ipt[i].valid && ipt[i].tag == tag)
            return i;
    return -1;
}

// mark ip row as mru , and age rest
inline void touch_ip(uint32_t index)
{
    uint8_t old = ipt[index].lru;
    for (uint32_t i = 0; i < IPT_SIZE; ++i)
        if (ipt[i].valid && ipt[i].lru < old)
            ++ipt[i].lru;
    ipt[index].lru = 0;
}

// prefer an unused ip entry otherwise return the least recently used row
inline uint32_t victim_ip()
{
    for (uint32_t i = 0; i < IPT_SIZE; ++i)
        if (!ipt[i].valid)
            return i;
    for (uint32_t i = 0; i < IPT_SIZE; ++i)
        if (ipt[i].lru == IPT_SIZE - 1)
            return i;
    return 0;
}

//for a signature if stride match increase conf 
//on mismatch if conf is 0 replace stride else decrement by 1
inline void train_spt(uint16_t sig, int8_t stride)
{
    SPTEntry &entry = spt[sig];
    if (entry.stride == stride) {
        if (entry.conf < SPT_CONF_MAX)
            ++entry.conf;
    } else if (entry.conf) {
        --entry.conf;
    } else {
        entry.stride = stride;
    }
}

// return 1 if already sent a prefetch request
inline bool filter_has(uint64_t line)
{
    const FilterEntry &entry = filter[filter_index(line)];
    return entry.valid && entry.tag == filter_tag(line);
}

// add entry for new prefetch in filter
// demand accesses can be recognized as useful
inline void remember_prefetch(uint64_t line)
{
    FilterEntry &entry = filter[filter_index(line)];
    entry = {true, false, filter_tag(line), epoch_id};
}

// mark it useful if cpu demands 
inline void check_useful(uint64_t line)
{
    FilterEntry &entry = filter[filter_index(line)];
    if (!entry.valid || entry.used || entry.tag != filter_tag(line))
        return;

    entry.used = true;
    // counting only if issued in the cur epoch
    if (entry.epoch == epoch_id)
        ++epoch_useful;
    ++total_useful;
}

//set the prefetch degree according to accuracy
inline uint32_t degree_for(uint32_t accuracy)
{
    if (accuracy >= ACC_HIGH) return 4;
    if (accuracy >= ACC_MID) return 3;
    if (accuracy >= ACC_LOW) return 2;
    return MIN_DEGREE;
}

//select the degree one epoch ends
inline void finish_epoch()
{
    degree = degree_for((epoch_useful * 100) / epoch_issued);
    epoch_issued = epoch_useful = 0;
    ++epoch_id;
}

} // namespace spp

using namespace spp;

// issue one prefetch candidate returning 0 tells to stop generating more candidates
static bool issue_prefetch(CACHE *cache, uint64_t ip, uint64_t addr,
                           uint64_t trigger, uint64_t line)
{
    //don't cross the 4 KB page
    if (page(trigger) != page(line))
        return false;
    // do not issue duplicate request
    if (filter_has(line))
        return true;

    // convert the cache ine number back to a byte address
    uint64_t pf_addr = line << LOG2_BLOCK_SIZE;
    // use L1 while MSHRs are occupied, otherwise fill L2
    int fill = cache->MSHR.occupancy < (cache->MSHR.SIZE >> 1)
                   ? FILL_L1 : FILL_L2;
    // ChampSim returns false when the request cannot be accepted
    if (!cache->prefetch_line(ip, addr, pf_addr, fill, 0))
        return false;

    // count requests that simulator accepts
    remember_prefetch(line);
    ++epoch_issued;
    ++total_issued;
    if (epoch_issued == EPOCH_SIZE)
        finish_epoch();
    return true;
}

void CACHE::l1d_prefetcher_initialize()
{
    //configuration summary
    std::cout << "SPP: " << IPT_SIZE << "-entry IP table, "
              << SIG_SIZE << "-entry signature table, degree "
              << MIN_DEGREE << ".." << MAX_DEGREE << std::endl;

    // initially every entry is invalid
    for (uint32_t i = 0; i < IPT_SIZE; ++i)
        ipt[i] = {false, false, 0, 0, 0, 0, 0, static_cast<uint8_t>(i)};
    // sig table is also empty
    for (uint32_t i = 0; i < SIG_SIZE; ++i)
        spt[i] = {0, 0};
    // empty filter table 
    for (uint32_t i = 0; i < FILTER_SIZE; ++i)
        filter[i] = {false, false, 0, 0};

    // reset all runtime counters
    epoch_issued = epoch_useful = total_issued = total_useful = 0;
    epoch_id = 0;
    degree = INITIAL_DEGREE;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit,
                                   uint8_t type, uint8_t critical_ip_flag)
{
    // check for load,ignore instruction and other requests.
    if (type != LOAD)
        return;

    // convert to cache line address
    uint64_t line = addr >> LOG2_BLOCK_SIZE;
    // Check usefulness
    check_useful(line);

    // find ip table entry for this ip
    uint16_t tag = ip_tag(ip);
    int index = find_ip(tag);
    if (index < 0) {
        // first access add entry
        index = victim_ip();
        ipt[index] = {true, false, tag, line_low(line), 0, 0, 0, 0};
        touch_ip(index);
        return;
    }

    // entry already there mark mru
    IPEntry &entry = ipt[index];
    touch_ip(index);

    // calculate signed distance between lines
    int64_t stride = static_cast<int16_t>(static_cast<uint16_t>(line_low(line) - entry.last_line));
    // same line encountered can skip
    if (!stride)
        return;
    // save last line 
    entry.last_line = line_low(line);

    // large jumps can't be safely represented or predicted within one page
    if (stride < -MAX_STRIDE || stride > MAX_STRIDE) {
        // clear both predictor modes and wait for a new pattern
        entry.last_stride = 0;
        entry.conf = 0;
        entry.has_sig = false;
        return;
    }

    // The 7-bit stride is safe for 1 page 
    int8_t s = static_cast<int8_t>(stride);
    // repeated stride in uniform
    if (s == entry.last_stride) {
        if (entry.conf < CONF_MAX)
            ++entry.conf;
    } else {
        //different stride break uniform conf
        entry.conf = 0;
    }
    // setting last stride
    entry.last_stride = s;

    // train old sig
    if (entry.has_sig)
        train_spt(entry.sig, s);
    // add new stirde to signature
    entry.sig = next_sig(entry.sig, s);
    entry.has_sig = true;

    // uniform mode has priority
    if (entry.conf >= UNIFORM_THRESH) {
        // predict upto cur degree
        for (uint32_t k = 1; k <= degree; ++k)
            if (!issue_prefetch(this, ip, addr, line, line + s * k))
                break;
        return;
    }

    // fall back to non uniform 
    // Use temp signature for predictions
    uint16_t signature = entry.sig;
    uint64_t predicted = line;
    for (uint32_t k = 0; k < degree; ++k) {
        // get predicted stride 
        const SPTEntry &prediction = spt[signature];
        // stop if no conf or no stride
        if (prediction.conf < SPT_THRESH || !prediction.stride)
            break;
        //predicted stride + current address
        predicted += prediction.stride;
        // stop if the page restriction or request queue prevents the issue
        if (!issue_prefetch(this, ip, addr, line, predicted))
            break;
        // pretend this prediction occurred to calculate the next
        signature = next_sig(signature, prediction.stride);
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr,
                                      uint32_t set, uint32_t way, uint8_t prefetch,
                                      uint64_t v_evicted_addr,
                                      uint64_t evicted_addr, uint32_t metadata_in)
{
        return; //metadata_in;
}

//lifetime usefulness and the degree selected by the final epoch
void CACHE::l1d_prefetcher_final_stats()
{
    std::cout << "CPU " << cpu << " SPP prefetches: " << total_issued
              << ", useful: " << total_useful;
    if (total_issued)
        std::cout << " (" << (100.0 * total_useful / total_issued) << "%)";
    std::cout << ", final degree: " << degree << std::endl;
}
